From 696e2a173eb695abe83bc7a10ee521c2832454db Mon Sep 17 00:00:00 2001
From: Jeroen Bobbeldijk <jeroen.bobbeldijk@doxis.com>
Date: Tue, 25 Aug 2026 08:39:21 +0200
Subject: [PATCH 5/5] simd: add per kernel switches for measurement

-DWASM_SIMD_OFF=IDCT_ISLOW switches one wasm kernel off and
-DNEON_SIMD_OFF=HUFF_ENCODE_ONE_BLOCK one translated Arm/Neon kernel,
handing that hook to whatever the dispatcher would otherwise pick.  Only
the dispatcher recompiles, so a leave one out series is cheap to build and
differs from the reference build in exactly one hook.

This is what makes it possible to attribute a speedup to individual
kernels rather than to a whole configuration, and to compare two
implementations of the same operation against the C code each of them
replaces.

The switches sit ahead of the CPU_TYPE branch chain on purpose:
set_source_files_properties() is directory scoped, so inside one branch
they would silently do nothing for every other configuration.
---
 simd/CMakeLists.txt | 18 ++++++++++++++++++
 simd/jsimd.c        |  2 ++
 simd/jsimdint.h     |  8 ++++++++
 3 files changed, 28 insertions(+)

diff --git a/simd/CMakeLists.txt b/simd/CMakeLists.txt
index e375c1c..e5fc51c 100644
--- a/simd/CMakeLists.txt
+++ b/simd/CMakeLists.txt
@@ -17,6 +17,24 @@ option(WITH_WASM_SIMD "Build the hand-written WebAssembly SIMD128 kernels.  They
   FALSE)
 
 
+# Measurement helpers.  -DWASM_SIMD_OFF=IDCT_ISLOW switches one wasm kernel
+# off, -DNEON_SIMD_OFF=HUFF_ENCODE_ONE_BLOCK one translated Arm/Neon kernel,
+# handing that hook to whatever the dispatcher would otherwise pick.  Only the
+# dispatcher recompiles.  These sit ahead of the branch chain because
+# set_source_files_properties() is directory-scoped: inside one branch they
+# would silently do nothing for every other configuration.
+set(SIMD_OFF_DEFS)
+if(DEFINED WASM_SIMD_OFF)
+  list(APPEND SIMD_OFF_DEFS "WASM_SIMD_${WASM_SIMD_OFF}=0")
+endif()
+if(DEFINED NEON_SIMD_OFF)
+  list(APPEND SIMD_OFF_DEFS "NEON_SIMD_${NEON_SIMD_OFF}=0")
+endif()
+if(SIMD_OFF_DEFS)
+  set_source_files_properties(jsimd.c PROPERTIES
+    COMPILE_DEFINITIONS "${SIMD_OFF_DEFS}")
+endif()
+
 ###############################################################################
 # x86[-64] (NASM)
 ###############################################################################
diff --git a/simd/jsimd.c b/simd/jsimd.c
index 73cf468..fba14c1 100644
--- a/simd/jsimd.c
+++ b/simd/jsimd.c
@@ -1539,12 +1539,14 @@ jsimd_set_huff_encode_one_block(j_compress_ptr cinfo)
     return JSIMD_SSE2;
   }
 #elif SIMD_ARCHITECTURE == ARM64 || SIMD_ARCHITECTURE == ARM
+#if NEON_SIMD_HUFF_ENCODE_ONE_BLOCK
   if ((cinfo->master->simd_support & JSIMD_NEON) &&
       cinfo->master->simd_huffman) {
     cinfo->entropy->huff_encode_one_block_simd =
       jsimd_huff_encode_one_block_neon;
     return JSIMD_NEON;
   }
+#endif
 #endif
 
   return JSIMD_NONE;
diff --git a/simd/jsimdint.h b/simd/jsimdint.h
index 7e6c324..feb22c7 100644
--- a/simd/jsimdint.h
+++ b/simd/jsimdint.h
@@ -210,6 +210,14 @@ DEFINE_SIMD_EXTRGB_COLOR_DECONVERTERS(rvv)
  *   -DWASM_SIMD_DEFAULT=0 -DWASM_SIMD_IDCT_ISLOW=1
  */
 
+/* The same idea for the translated Arm/Neon kernels, so that a build can hand
+ * one hook back to C and measure what upstream's kernel is worth on its own
+ * terms.  Only the hooks we need to isolate are listed.
+ */
+#ifndef NEON_SIMD_HUFF_ENCODE_ONE_BLOCK
+#define NEON_SIMD_HUFF_ENCODE_ONE_BLOCK  1
+#endif
+
 #ifdef WITH_WASM_SIMD
 
 #ifndef WASM_SIMD_DEFAULT
