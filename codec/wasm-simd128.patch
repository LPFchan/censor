                                        JSAMPARRAY *output_data_ptr);
 
-#if SIMD_ARCHITECTURE == ARM64 || SIMD_ARCHITECTURE == ARM
+#if SIMD_ARCHITECTURE == ARM64 || SIMD_ARCHITECTURE == ARM || \
+    defined(WITH_NEON_GAP_KERNELS)
