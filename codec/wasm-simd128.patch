From eb94876961d5bf5994724bda2cb9c7c71cbe0c84 Mon Sep 17 00:00:00 2001
From: Jeroen Bobbeldijk <jeroen.bobbeldijk@doxis.com>
Date: Tue, 25 Aug 2026 08:39:05 +0200
Subject: [PATCH 4/5] build: pick a sane FLOATTEST default for WebAssembly

Emscripten reports CPU_TYPE as i386, so with WITH_SIMD on, FLOATTEST8
defaults to sse and the 3x2-float-prog tests expect the results x86 SIMD
would produce.  A wasm build has no float DCT/IDCT kernels, so those paths
run the generic C code and the two tests fail on an otherwise healthy
build.

Default FLOATTEST8 and FLOATTEST12 to fp-contract when SIMD_ARCHITECTURE
is WASM.  This is a test expectation fix; no library code changes.

With it, the full suite passes 332/332 under node for the wasm and the
wasm plus SIMDe configurations.  (Running the suite under emscripten also
requires linking the tools with -sNODERAWFS=1, otherwise every test fails
on "can't open" against emscripten's virtual filesystem.)
---
 CMakeLists.txt | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index a1293db..28e44d0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1087,7 +1087,12 @@ endif()
 #        with a 32-bit version of Visual C++ and /arch:IA32 (which was the
 #        default in Visual C++ 2010 and earlier)
 
-if(CPU_TYPE STREQUAL "x86_64" OR CPU_TYPE STREQUAL "i386")
+if(SIMD_ARCHITECTURE STREQUAL "WASM")
+  # Emscripten reports CPU_TYPE i386, which would select the x86 SSE expected
+  # results below.  The wasm kernels do not implement the float DCT/IDCT, so
+  # those tests see generic FPU results instead.
+  set(DEFAULT_FLOATTEST8 fp-contract)
+elseif(CPU_TYPE STREQUAL "x86_64" OR CPU_TYPE STREQUAL "i386")
   if(WITH_SIMD)
     set(DEFAULT_FLOATTEST8 sse)
   elseif(CPU_TYPE STREQUAL "x86_64")
@@ -1139,7 +1144,9 @@ if(FLOATTEST8)
   endif()
 endif()
 
-if(CPU_TYPE STREQUAL "x86_64")
+if(SIMD_ARCHITECTURE STREQUAL "WASM")
+  set(DEFAULT_FLOATTEST12 fp-contract)
+elseif(CPU_TYPE STREQUAL "x86_64")
   set(DEFAULT_FLOATTEST12 no-fp-contract)
 elseif(CPU_TYPE STREQUAL "powerpc" OR CPU_TYPE STREQUAL "arm64")
   if(CMAKE_C_COMPILER_ID MATCHES "Clang")
