diff --git a/simd/CMakeLists.txt b/simd/CMakeLists.txt
index 48f215d..9abfbf5 100644
--- a/simd/CMakeLists.txt
+++ b/simd/CMakeLists.txt
@@ -13,12 +13,79 @@ endmacro()
 option(WITH_SIMDE "Use SIMD Everywhere or Emscripten to translate Arm/Neon intrinsics into SIMD intrinsics for other platforms (Experimental)"
   FALSE)
 
+option(WITH_WASM_SIMD "Build the hand-written WebAssembly SIMD128 kernels.  They are preferred over any translated Arm/Neon kernel for the same operation; every other kernel still comes from the translated set, so coverage is not reduced.  Requires a wasm target and -msimd128. (Experimental)"
+  FALSE)
+
 
 ###############################################################################
 # x86[-64] (NASM)
 ###############################################################################
 
-if((CPU_TYPE STREQUAL "x86_64" OR CPU_TYPE STREQUAL "i386") AND NOT WITH_SIMDE)
+if(WITH_WASM_SIMD)
+
+# WebAssembly SIMD128.
+#
+# The hand-written wasm kernels are the architecture here, not an addition to
+# somebody else's: SIMD_ARCHITECTURE is WASM, which matters because
+# src/jchuff.c picks the width of the SIMD bit buffer from it (64-bit unless
+# the architecture is Arm).  Building these kernels on top of an Arm
+# configuration would silently give them a 32-bit buffer to write 64-bit
+# values into.
+#
+# With WITH_SIMDE as well, the translated Arm/Neon kernels are compiled in to
+# cover the operations the wasm set does not implement, and are dispatched
+# only for those.  Coverage is then never worse than WITH_SIMDE alone.
+
+set(SIMD_ARCHITECTURE WASM PARENT_SCOPE)
+add_definitions(-DWITH_WASM_SIMD)
+
+set(SIMD_SOURCES wasm/jccolor-wasm.c wasm/jchuff-wasm.c wasm/jcphuff-wasm.c
+  wasm/jcsample-wasm.c wasm/jdcolor-wasm.c wasm/jdsample-wasm.c
+  wasm/jfdctint-wasm.c wasm/jidctint-wasm.c wasm/jquanti-wasm.c)
+
+if(WITH_SIMDE)
+  # Only the files providing operations the wasm kernels do not implement.
+  # arm/jchuff-neon.c is deliberately absent: its bit-buffer width follows
+  # SIMD_ARCHITECTURE, and the wasm Huffman kernel owns that hook regardless.
+  set(NEON_GAP_SOURCES arm/jcgray-neon.c arm/jdcolor-neon.c arm/jdmerge-neon.c
+    arm/jdsample-neon.c arm/jfdctfst-neon.c arm/jidctfst-neon.c
+    arm/jidctred-neon.c)
+  if(WITH_NEON_HEAD_TO_HEAD)
+    # Also build the translated kernels for operations the wasm set DOES
+    # implement, so that switching one wasm kernel off hands that hook to Neon
+    # rather than to C.  Measurement only: the default dispatch is unchanged,
+    # because the wasm branch is tested first.  jchuff is still excluded - its
+    # bit-buffer width follows SIMD_ARCHITECTURE.
+    set(NEON_GAP_SOURCES ${NEON_GAP_SOURCES} arm/jccolor-neon.c
+      arm/jcphuff-neon.c arm/jcsample-neon.c arm/jfdctint-neon.c
+      arm/jidctint-neon.c arm/jquanti-neon.c)
+    add_definitions(-DWITH_NEON_HEAD_TO_HEAD)
+  endif()
+
+  if(NOT DEFINED HAVE_VLD1_S16_X3)
+    set(HAVE_VLD1_S16_X3 1)
+  endif()
+  if(NOT DEFINED HAVE_VLD1_U16_X2)
+    set(HAVE_VLD1_U16_X2 1)
+  endif()
+  if(NOT DEFINED HAVE_VLD1Q_U8_X4)
+    set(HAVE_VLD1Q_U8_X4 0)
+  endif()
+  configure_file(arm/neon-compat.h.in arm/neon-compat.h @ONLY)
+  include_directories(arm ${CMAKE_CURRENT_BINARY_DIR}/arm)
+
+  set_source_files_properties(${NEON_GAP_SOURCES} PROPERTIES
+    COMPILE_FLAGS "-mfpu=neon -DNEON_INTRINSICS -DWITH_NEON_GAP_KERNELS")
+  set(SIMD_SOURCES ${SIMD_SOURCES} ${NEON_GAP_SOURCES})
+  add_definitions(-DWITH_NEON_GAP_KERNELS)
+endif()
+
+add_library(simd OBJECT ${SIMD_SOURCES} wasm/jsimdcpu.c jsimd.c)
+if(NOT WIN32 AND (CMAKE_POSITION_INDEPENDENT_CODE OR ENABLE_SHARED))
+  set_target_properties(simd PROPERTIES POSITION_INDEPENDENT_CODE 1)
+endif()
+
+elseif((CPU_TYPE STREQUAL "x86_64" OR CPU_TYPE STREQUAL "i386") AND NOT WITH_SIMDE)
 
 string(TOUPPER ${CPU_TYPE} SIMD_ARCHITECTURE)
 set(SIMD_ARCHITECTURE ${SIMD_ARCHITECTURE} PARENT_SCOPE)
@@ -231,6 +298,7 @@ endif()
 # Arm (Intrinsics)
 ###############################################################################
 
+
 elseif(CPU_TYPE STREQUAL "arm64" OR CPU_TYPE STREQUAL "arm" OR WITH_SIMDE)
 
 string(TOUPPER ${CPU_TYPE} SIMD_ARCHITECTURE)
@@ -358,6 +426,16 @@ if(BITS EQUAL 32)
   set_source_files_properties(${SIMD_SOURCES} COMPILE_FLAGS "-mfpu=neon ${SOFTFP_FLAG}")
 endif()
 
+if(WITH_WASM_SIMD)
+  # The wasm kernels must NOT get -mfpu=neon: they are written against
+  # wasm_simd128.h directly, so they are appended after the flags above.
+  set(SIMD_SOURCES ${SIMD_SOURCES} wasm/jccolor-wasm.c wasm/jchuff-wasm.c
+    wasm/jcphuff-wasm.c wasm/jcsample-wasm.c wasm/jdcolor-wasm.c
+    wasm/jdsample-wasm.c wasm/jfdctint-wasm.c wasm/jidctint-wasm.c
+    wasm/jquanti-wasm.c)
+  add_definitions(-DWITH_WASM_SIMD)
+endif()
+
 if(UNIX AND BITS EQUAL 32)
   include(CheckSymbolExists)
   check_symbol_exists(getauxval sys/auxv.h HAVE_GETAUXVAL)
