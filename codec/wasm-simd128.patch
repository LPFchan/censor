 #if SIMD_ARCHITECTURE == ARM64 || SIMD_ARCHITECTURE == ARM || \
-    defined(WITH_NEON_HEAD_TO_HEAD)
+    defined(WITH_NEON_HEAD_TO_HEAD) || defined(WITH_NEON_GAP_KERNELS)
 
