From c84952253e4174860f64c4569dbf1c7c3ae9bcd8 Mon Sep 17 00:00:00 2001
From: Jeroen Bobbeldijk <jeroen.bobbeldijk@doxis.com>
Date: Tue, 25 Aug 2026 08:39:05 +0200
Subject: [PATCH 3/5] simd: let h1v2_fancy_upsample dispatch when the Neon gap
 kernels are built

The h1v2 hook is guarded as Arm only in three places: the setter in
simd/jsimd.c, the call site in src/jdsample.c, and the entry in
simd/simdcoverage.c.  A build that compiles the translated Arm/Neon
kernels alongside a different SIMD_ARCHITECTURE therefore lost this one
operation to C, even though the kernel was compiled in.

Widening the three guards with WITH_NEON_GAP_KERNELS is not enough on its
own, because that macro was defined with add_definitions() inside simd/,
which does not reach src/jdsample.c.  The symptom is easy to miss:
simdcoverage (also in simd/) reports the hook as covered while the decode
path still runs the C version, and the relinked binary is byte identical
because LTO strips the setter nobody calls.  So the flag is now carried
through jconfigint.h, the way SIMD_ARCHITECTURE already crosses the same
boundary.

Coverage for the wasm plus SIMDe configuration goes from 27 to 28 hooks.
---
 simd/CMakeLists.txt | 4 ++++
 simd/jsimd.c        | 2 +-
 simd/jsimd.h        | 3 ++-
 simd/simdcoverage.c | 3 ++-
 src/jconfigint.h.in | 4 ++++
 src/jdsample.c      | 4 +++-
 6 files changed, 16 insertions(+), 4 deletions(-)

diff --git a/simd/CMakeLists.txt b/simd/CMakeLists.txt
index 1a4fb7d..e375c1c 100644
--- a/simd/CMakeLists.txt
+++ b/simd/CMakeLists.txt
@@ -78,6 +78,10 @@ if(WITH_SIMDE)
     COMPILE_FLAGS "-mfpu=neon -DNEON_INTRINSICS -DWITH_NEON_GAP_KERNELS")
   set(SIMD_SOURCES ${SIMD_SOURCES} ${NEON_GAP_SOURCES})
   add_definitions(-DWITH_NEON_GAP_KERNELS)
+  # src/jdsample.c also has to see this: the h1v2 hook is guarded there too,
+  # and add_definitions() reaches this directory only.  jconfigint.h is how
+  # upstream already carries SIMD_ARCHITECTURE across the same boundary.
+  set(WITH_NEON_GAP_KERNELS 1 PARENT_SCOPE)
 endif()
 
 add_library(simd OBJECT ${SIMD_SOURCES} wasm/jsimdcpu.c jsimd.c)
diff --git a/simd/jsimd.c b/simd/jsimd.c
index f1eaf4f..73cf468 100644
--- a/simd/jsimd.c
+++ b/simd/jsimd.c
